# Copy to backend/.env (run_linux.sh does this automatically on first run).

# LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral-large-3:675b-cloud
OLLAMA_TIMEOUT=600

# Literature search
OPENALEX_EMAIL=your@email.com
OPENALEX_RESULTS_PER_PAGE=15

# Number of dynamic theoretical lenses (default: 4)
NUM_DYNAMIC_LENSES=4

# BERT Semantic Topography (Topology tab, DR1 lens cosine, DR5 clustering)
# Requires: pip install sentence-transformers umap-learn hdbscan
BERT_ENABLED=true
BERT_MODEL=allenai/scibert_scivocab_uncased

# Neo4j Graph Persistence (optional)
# NEO4J_ENABLED=true
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_password
